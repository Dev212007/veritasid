# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/veritasid

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_minimum_32_chars
JWT_EXPIRES_IN=7d

# Blockchain (Local Hardhat)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# IPFS / Pinata
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Contract Addresses (filled after deployment)
DID_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=
PERMISSION_MANAGER_ADDRESS=

# Encryption
ENCRYPTION_KEY=your_32_byte_encryption_key_here_must_be_exactly_32
